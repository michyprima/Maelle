; $MODE = "UniformRegister"
; $SAMPLER_VARS[0].name = "colors"
; $SAMPLER_VARS[0].type = "sampler2D"
; $SAMPLER_VARS[0].location = 0
; $NUM_SPI_PS_INPUT_CNTL = 3
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[2].SEMANTIC = 2
; $SPI_PS_INPUT_CNTL[2].DEFAULT_VAL = 1

; Packing: R0 has this pixel's coordinates in the finished colors. Each color is written as the bytes of the 3D pixel
; the 2D engine uses, so the CPU only has to copy it: 6-bit red, green, blue and alpha from bit 0 up, then bit 26 set.
; The output channels land in memory in order, from the top byte of that word down. All the values are whole numbers
; below 256, which floats hold exactly, and bits are split with floor. Instructions are packed into groups
; by the rules in README.md, which the assembler doesn't check.
00 TEX: ADDR(80) CNT(1) VALID_PIX
    0  SAMPLE R3, R0.xy00, t0, s0
01 ALU: ADDR(32) CNT(37)
    1  x: MUL R4.x, R3.x, (0x427F0000, 63.75f).x
       y: MUL R4.y, R3.y, (0x427F0000, 63.75f).y
       z: MUL R4.z, R3.z, (0x427F0000, 63.75f).z
       w: MUL R4.w, R3.w, (0x427F0000, 63.75f).w
    2  x: ADD R4.x, R4.x, (0x3A83126F, 0.001f).x
       y: ADD R4.y, R4.y, (0x3A83126F, 0.001f).y
       z: ADD R4.z, R4.z, (0x3A83126F, 0.001f).z
       w: ADD R4.w, R4.w, (0x3A83126F, 0.001f).w
    3  x: FLOOR R4.x, R4.x
       y: FLOOR R4.y, R4.y
       z: FLOOR R4.z, R4.z
       w: FLOOR R4.w, R4.w
    4  x: MOV R6.x, (0x40800000, 4.0f).x
       y: MUL R5.y, R4.y, (0x3E800000, 0.25f).y
       z: MUL R5.z, R4.z, (0x3D800000, 0.0625f).z
    5  x: MUL R6.x, R6.x, (0x3B808081, 0.003921569f).x
       y: FLOOR R5.y, R5.y
       z: FLOOR R5.z, R5.z
    6  x: MULADD R5.x, R5.y, (0xC0800000, -4.0f).x, R4.y
       w: MULADD R5.w, R5.z, (0xC1800000, -16.0f).y, R4.z
    7  z: MULADD R6.z, R5.w, (0x41800000, 16.0f).x, R5.y
       w: MULADD R6.w, R5.x, (0x42800000, 64.0f).y, R4.x
    8  y: MULADD R6.y, R4.w, (0x40800000, 4.0f).x, R5.z
       z: MUL R6.z, R6.z, (0x3B808081, 0.003921569f).y
    9  y: MUL R6.y, R6.y, (0x3B808081, 0.003921569f).x
       w: MUL R6.w, R6.w, (0x3B808081, 0.003921569f).y
02 EXP_DONE: PIX0, R6
END_OF_PROGRAM
