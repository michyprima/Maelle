; $MODE = "UniformRegister"
; $SAMPLER_VARS[0].name = "colors"
; $SAMPLER_VARS[0].type = "sampler2D"
; $SAMPLER_VARS[0].location = 0
; $NUM_SPI_PS_INPUT_CNTL = 3
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[2].SEMANTIC = 2
; $SPI_PS_INPUT_CNTL[2].DEFAULT_VAL = 1

; Copying to the DS's resolution: R0 has this pixel's coordinates in a frame twice as big, which land between 4 of its
; pixels. Half of one of those pixels is taken off, so each pixel copies the top-left one, which is the one the 2D
; engine reads from high-res frames. Instructions are packed into groups
; by the rules in README.md, which the assembler doesn't check.
00 ALU: ADDR(32) CNT(3)
    0  x: ADD R0.x, R0.x, (0xBA800000, -0.0009765625f).x
       y: ADD R0.y, R0.y, (0xBAAAAAAB, -0.0013020834f).y
01 TEX: ADDR(48) CNT(1) VALID_PIX
    1  SAMPLE R1, R0.xy00, t0, s0
02 EXP_DONE: PIX0, R1
END_OF_PROGRAM
